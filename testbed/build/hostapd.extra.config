# Deltas appended to the hostapd build config (your .config if present, else
# hostap's defconfig). Duplicate keys are harmless: the last assignment wins.

# Drivers
CONFIG_DRIVER_WIRED=y
CONFIG_DRIVER_NONE=y

# hostapd's -f option. Without this, wpa_debug_open_file() compiles to nothing,
# -f is accepted and silently ignored, and the debug output goes to stdout
# block buffered. Two hostapd instances run in the authradius container — the
# RADIUS server and the authenticator — so that leaves them interleaved on one
# stream, and the tail of a run sitting in a buffer that is never flushed. With
# it, each writes line buffered to its own file and logs.sh can read either.
# hostap's defconfig has it off; wpa_supplicant's .config already turns it on.
CONFIG_DEBUG_FILE=y

# Integrated RADIUS authentication server (needed for radius_server_clients)
CONFIG_RADIUS_SERVER=y

# Baseline EAP server methods (smoke test = MD5; baselines = PEAP/TTLS)
CONFIG_EAP_MD5=y
CONFIG_EAP_TLS=y
CONFIG_EAP_PEAP=y
CONFIG_EAP_TTLS=y
CONFIG_EAP_MSCHAPV2=y
CONFIG_EAP_GTC=y

# >>> EAP-DID server method: enable once present in your fork <<<
#CONFIG_EAP_DID=y
CONFIG_EAP_DID=y
CONFIG_EAP_FILEAUTH=y
