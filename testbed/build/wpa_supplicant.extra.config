# Deltas appended to the wpa_supplicant build config (your .config if present,
# else hostap's defconfig). Duplicate keys are harmless: last assignment wins.

# Drivers + wired 802.1X
CONFIG_DRIVER_WIRED=y
CONFIG_DRIVER_NONE=y
CONFIG_IEEE8021X_EAPOL=y

# Baseline EAP peer methods
CONFIG_EAP_MD5=y
CONFIG_EAP_TLS=y
CONFIG_EAP_PEAP=y
CONFIG_EAP_TTLS=y
CONFIG_EAP_MSCHAPV2=y
CONFIG_EAP_GTC=y

# >>> EAP-DID peer method: enable once present in your fork <<<
#CONFIG_EAP_DID=y
CONFIG_EAP_DID=y
