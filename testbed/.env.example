# EAP-DID did5 testbed configuration
# Copy to .env and fill with values from provision.sh + extract-did5-keys.sh
#
# Private keys are not configured here. extract-did5-keys.sh writes them to
# did-keys/ as 0600 files, docker-compose.yml mounts them, and the supplicant
# is told where they are through the DID_*_FILE variables.
SCHEMA_ID=
ISSUER_DID=
DID_HOLDER_DID=
DID_PRISM_KEY_ID=
